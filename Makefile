# my-radar-ideas: single entry point for humans, agents and CI.
# No containers: the host needs make, git, python3 and uv (jobs/).
# Generated by the my-playbook starter; `copier update` refreshes it.
SHELL := /usr/bin/env bash
.SHELLFLAGS := -euo pipefail -c
.DEFAULT_GOAL := help

CURRENT_BRANCH := $(shell git rev-parse --abbrev-ref HEAD 2>/dev/null)
# jobs/ runs on the host with uv (no Docker). uv syncs the dev group (pytest, ruff) on first use.
JOBS_RUN := uv run --directory jobs

.PHONY: help bootstrap doctor env lint lint-prompts test test-scripts test-hooks ci estado push handoff \
        lint-jobs test-jobs fmt-jobs

help: ## Muestra esta ayuda
	@grep -hE '^[a-zA-Z0-9_-]+:.*?## ' $(MAKEFILE_LIST) \
	  | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-18s\033[0m %s\n", $$1, $$2}'

# ---------------------------------------------------------------------------
# Arranque y salud de la máquina
# ---------------------------------------------------------------------------

bootstrap: ## Primera vez en una máquina: crea .env, .playbook/ y chequea requisitos (no levanta nada)
	@mkdir -p .playbook
	@for tool in git make python3 uv; do \
	  command -v $$tool >/dev/null 2>&1 || { echo "FALLA falta $$tool en el PATH" >&2; exit 1; }; \
	done
	@./scripts/init-env.sh
	@chmod +x scripts/*.sh 2>/dev/null || true
	@echo "Bootstrap listo. Seguí con: make doctor"

doctor: ## Chequea plugin my-flow, .playbook/, rutas absolutas en docs, uv y herramientas de jobs
	@./scripts/doctor.sh

env: ## Crea .env con claves nuevas; si ya existe, agrega las que falten (las *_API_KEY y *_TOKEN quedan vacías)
	@./scripts/init-env.sh

.env:
	@./scripts/init-env.sh

# ---------------------------------------------------------------------------
# Lint y tests (sin red, sin claves)
# ---------------------------------------------------------------------------

lint-jobs: ## Revisa estilo de jobs/ (ruff, en el host con uv)
	$(JOBS_RUN) ruff check .
	$(JOBS_RUN) ruff format --check .

test-jobs: ## Corre los tests de jobs/ (pytest, sin red ni claves)
	$(JOBS_RUN) pytest

fmt-jobs: ## Formatea jobs/
	$(JOBS_RUN) ruff format .
	$(JOBS_RUN) ruff check --fix .

lint-prompts: ## Busca patrones prohibidos y rutas absolutas en planes, cards y prompts
	@./scripts/lint-prompts.sh

lint: lint-prompts lint-jobs ## Revisa estilo y tipos de todo

test-scripts: ## Corre los tests de los scripts de bash (scripts/tests/*.sh)
	@if compgen -G "scripts/tests/*.sh" >/dev/null; then \
	  for t in scripts/tests/*.sh; do echo "==> $$t"; bash "$$t"; done; \
	else echo "No hay tests en scripts/tests/ todavía."; fi

test-hooks: ## Corre los tests de los hooks del proyecto si existen (scripts/test-hooks.sh)
	@if [[ -x scripts/test-hooks.sh ]]; then ./scripts/test-hooks.sh; \
	else echo "No hay scripts/test-hooks.sh: los hooks viven en el plugin my-flow y se testean en el playbook."; fi

test: test-scripts test-jobs ## Corre todos los tests unitarios

# The only green gate. On success it records the tree hash so the Stop hook
# of my-flow can tell whether the tree changed since the last green run.
ci: ## Corre el CI local completo y marca el árbol como verde (.playbook/ci-ok)
	./scripts/ci.sh
	@mkdir -p .playbook
	@./scripts/tree_hash.sh > .playbook/ci-ok
	@echo "Marcado verde en .playbook/ci-ok ($$(cat .playbook/ci-ok))."

# ---------------------------------------------------------------------------
# Estado, push y traspaso
# ---------------------------------------------------------------------------

estado: ## Regenera el bloque vivo de docs/etapas/ESTADO.md
	@python3 scripts/estado.py

# Rebase first so the push never bounces; never --force (the hook blocks it).
# Then verify the remote really points at our HEAD.
push: ## Pushea la rama actual (pull --rebase --autostash antes) y verifica el SHA remoto
	@if [[ "$(CURRENT_BRANCH)" == "main" ]]; then \
	  read -r -p "Estás en main: a main solo se pushea con GATE 2 aprobado. Escribí 'main' para seguir: " answer; \
	  if [[ "$$answer" != "main" ]]; then echo "Cancelado."; exit 1; fi; \
	fi
	git pull --rebase --autostash origin "$(CURRENT_BRANCH)" 2>/dev/null || git fetch origin
	git push -u origin HEAD
	@local_sha="$$(git rev-parse HEAD)"; remote_sha="$$(git rev-parse "origin/$(CURRENT_BRANCH)")"; \
	  if [[ "$$local_sha" != "$$remote_sha" ]]; then \
	    echo "FALLA: origin/$(CURRENT_BRANCH) ($$remote_sha) no coincide con HEAD ($$local_sha)." >&2; exit 1; \
	  fi; \
	  echo "OK: origin/$(CURRENT_BRANCH) @ $$remote_sha"

handoff: ## Lista ramas sin upstream y worktrees sucios; falla si hay (antes de cambiar de máquina o cerrar etapa)
	@fail=0; \
	echo "Ramas locales sin upstream:"; \
	while IFS= read -r line; do \
	  branch="$${line%% *}"; upstream="$${line#* }"; \
	  if [[ -z "$$upstream" || "$$upstream" == "$$branch" ]]; then echo "  - $$branch"; fail=1; fi; \
	done < <(git for-each-ref --format='%(refname:short) %(upstream:short)' refs/heads/); \
	echo "Worktrees con cambios sin commitear:"; \
	while IFS= read -r wt; do \
	  [[ -d "$$wt" ]] || continue; \
	  if [[ -n "$$(git -C "$$wt" status --porcelain 2>/dev/null)" ]]; then echo "  - $$wt"; fail=1; fi; \
	done < <(git worktree list --porcelain | sed -n 's/^worktree //p'); \
	if [[ $$fail -ne 0 ]]; then echo "FALLA: hay trabajo que no está en GitHub. Commiteá y corré make push en cada rama." >&2; exit 1; fi; \
	echo "OK: todo está commiteado y con upstream."
