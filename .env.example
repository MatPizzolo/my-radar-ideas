# Environment for my-radar-ideas (local development).
#
# Do not edit secrets by hand: run `make env` (scripts/init-env.sh). It copies
# this file to .env and fills every empty value below with a random secret,
# EXCEPT keys ending in _API_KEY or _TOKEN: those are provider credentials, they
# stay empty and the script lists them so you paste the real value (or leave
# them empty: tests and CI run with fakes). If .env already exists, only the
# missing keys are appended; existing lines are never changed.
# Never commit .env. This file carries no values, only keys and safe defaults.


# --- Providers for jobs/ (fake by default: never a paid API in tests or make ci)
# credential: left empty by init-env.sh, paste the real one only for real runs
LLM_API_KEY=
